# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Data sources ──────────────────────────────────────────────────────────────
FMP_API_KEY=...                     # Financial Modeling Prep
FRED_API_KEY=...                    # FRED (St. Louis Fed) — free
POLYGON_API_KEY=...                 # Polygon.io

# ── Vector store ──────────────────────────────────────────────────────────────
VECTOR_STORE=chroma                 # chroma | qdrant
QDRANT_URL=http://localhost:6333    # only if VECTOR_STORE=qdrant
QDRANT_API_KEY=                     # only for Qdrant Cloud

# ── LangSmith tracing ─────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=swing-trader-dev  # swing-trader-dev | swing-trader-prod

# ── Postgres (eval store) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost/swing_trader_dev

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_VERSION=0.1.0
ENVIRONMENT=development             # development | production
LAYER2_CONFIDENCE_THRESHOLD=0.60    # gate: minimum confidence to pass Layer 2

# ── Prometheus metrics ────────────────────────────────────────────────────────
METRICS_PORT=9090
