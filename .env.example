# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...                    # https://console.groq.com
JINA_API_KEY=jina_...                   # https://jina.ai

# ── Recommended (features degrade without these) ─────────────────────────────
DATABASE_URL=postgresql://localhost/swing_trader_dev
FMP_API_KEY=...                         # Financial Modeling Prep
FRED_API_KEY=...                        # https://fred.stlouisfed.org
POLYGON_API_KEY=...                     # https://polygon.io

# ── Model config ──────────────────────────────────────────────────────────────
LLM_FAST_MODEL=llama-3.2-3b-preview
LLM_MID_MODEL=llama-3.1-8b-instant
LLM_JUDGE_MODEL=llama-3.3-70b-versatile
EMBED_MODEL=jina-embeddings-v2-base-en

# ── API security ─────────────────────────────────────────────────────────────
# API_KEYS=key1,key2                    # Comma-separated; empty = auth disabled (dev)
# CORS_ORIGINS=https://yourdomain.com   # Comma-separated; empty = localhost only
# RATE_LIMIT_PER_MINUTE=30

# ── Guardrails ────────────────────────────────────────────────────────────────
# GUARDRAIL_MAX_RETRIES=2
# GUARDRAIL_CONFIDENCE_FLOOR=0.40
# GUARDRAIL_DATA_GAP_THRESHOLD=4

# ── Vector store ──────────────────────────────────────────────────────────────
VECTOR_STORE=chroma
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=swing-trader-dev

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_VERSION=0.1.0
ENVIRONMENT=development
LAYER2_CONFIDENCE_THRESHOLD=0.60

# ── Docker passwords (override defaults) ─────────────────────────────────────
# POSTGRES_PASSWORD=swingtrader
# GRAFANA_PASSWORD=admin
